{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"pages:preview": "wrangler pages dev build",
		"deploy": "pnpm build && wrangler pages deploy build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/leaflet": "^1.9.22",
		"@types/three": "^0.185.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.113.0"
	},
	"dependencies": {
		"@clerk/clerk-js": "^5.127.2",
		"@lucide/svelte": "^1.25.0",
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"leaflet": "^1.9.4",
		"three": "^0.185.1"
	}
}
